Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Image
      Name: Robot RGB camera
      Enabled: true
      Topic:
        Value: /color/image
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Durability Policy: Volatile
      Transport Hint: raw
  Global Options:
    Fixed Frame: robot/base_link
    Frame Rate: 20
Window Geometry:
  Width: 1100
  Height: 720
